TZ=Asia/Riyadh
DOMAIN=carbonflows.store

# Cloudflare Tunnel
# أنشئ Tunnel من لوحة Cloudflare ثم ضع token هنا.
CLOUDFLARED_TOKEN=CHANGE_ME
CF_API_TOKEN=CHANGE_ME
CF_ZONE_ID=CHANGE_ME

# Nginx Proxy Manager
NPM_DB_PASSWORD=CHANGE_ME
NPM_DB_ROOT_PASSWORD=CHANGE_ME

# LiteCart / MariaDB
LITECART_DB_NAME=CHANGE_ME
LITECART_DB_USER=CHANGE_ME
LITECART_DB_PASSWORD=CHANGE_ME
LITECART_DB_ROOT_PASSWORD=CHANGE_ME

# n8n
N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_BASIC_AUTH_USER=CHANGE_ME
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME
N8N_HOST=n8n.carbonflows.store
N8N_WEBHOOK_URL=https://n8n.carbonflows.store/

# Ollama
OLLAMA_MODEL=phi3:mini

# Telemetry logger
TELEMETRY_TOKEN=CHANGE_ME

# Optional integrations for n8n workflows
SUPPORT_EMAIL=support@carbonflows.store
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
MOYASAR_API_KEY=CHANGE_ME
TAP_SECRET_KEY=CHANGE_ME

# Release and GitHub Actions integration
RELEASE_WEBHOOK_SECRET=CHANGE_ME
RELEASE_API_TOKEN=CHANGE_ME
GITHUB_DEPLOY_PUBLIC_KEY=CHANGE_ME
GITHUB_WEBHOOK_ALLOWED_REPO=CHANGE_ME

# Email engine via SMTP relay/domain provider
SYSTEM_EMAIL=info@carbonflow.care
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_TLS=YES
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CarbonFlow AI <noreply@carbonflows.store>
EMAIL_AUDIT_LOG=CHANGE_ME
CREDENTIAL_RECOVERY_EMAIL=far7an.o88@gmail.com

# Hybrid encrypted backups
BACKUP_ENCRYPTION_KEY=CHANGE_ME
BACKUP_RETENTION_DAYS=14

# Lightweight token control panel
CONTROL_PANEL_USER=CHANGE_ME
CONTROL_PANEL_PASSWORD=CHANGE_ME
N8N_API_KEY=CHANGE_ME
