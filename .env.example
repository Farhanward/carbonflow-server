TZ=Asia/Riyadh
DOMAIN=carbonflows.store

# Cloudflare Tunnel
# أنشئ Tunnel من لوحة Cloudflare ثم ضع token هنا.
CLOUDFLARED_TOKEN=replace_with_cloudflare_tunnel_token
CF_API_TOKEN=
CF_ZONE_ID=

# Nginx Proxy Manager
NPM_DB_PASSWORD=change_me_npm_password
NPM_DB_ROOT_PASSWORD=change_me_npm_root_password

# LiteCart / MariaDB
LITECART_DB_NAME=litecart
LITECART_DB_USER=litecart
LITECART_DB_PASSWORD=change_me_litecart_password
LITECART_DB_ROOT_PASSWORD=change_me_litecart_root_password

# n8n
N8N_ENCRYPTION_KEY=replace_with_32_plus_random_chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_n8n_admin_password
N8N_HOST=n8n.carbonflows.store
N8N_WEBHOOK_URL=https://n8n.carbonflows.store/

# Ollama
OLLAMA_MODEL=phi3:mini

# Telemetry logger
TELEMETRY_TOKEN=change_me_long_random_token

# Optional integrations for n8n workflows
SUPPORT_EMAIL=info@carbonflow.care
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MOYASAR_API_KEY=
TAP_SECRET_KEY=

# Release and GitHub Actions integration
RELEASE_WEBHOOK_SECRET=change_me_release_webhook_secret
RELEASE_API_TOKEN=change_me_release_api_token
GITHUB_DEPLOY_PUBLIC_KEY=
GITHUB_WEBHOOK_ALLOWED_REPO=

# Email engine via SMTP relay/domain provider
SYSTEM_EMAIL=info@carbonflow.care
SMTP_HOST=mail.carbonflow.care
SMTP_PORT=587
SMTP_TLS=YES
SMTP_USER=info@carbonflow.care
SMTP_PASSWORD=123456!
SMTP_FROM=CarbonFlow Tech <info@carbonflow.care>
EMAIL_AUDIT_LOG=/vault/mail/mail-audit.log
CREDENTIAL_RECOVERY_EMAIL=far7an.o88@gmail.com

# Hybrid encrypted backups
BACKUP_ENCRYPTION_KEY=change_me_backup_encryption_key
BACKUP_RETENTION_DAYS=14

# Lightweight token control panel
CONTROL_PANEL_USER=admin
CONTROL_PANEL_PASSWORD=change_me_control_panel_password
